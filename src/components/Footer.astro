---
import { siteConfig } from '../data/siteConfig';
---

<footer class="border-t border-gray-800/80 bg-[#05060A] py-14 text-sm text-gray-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-10 border-b border-gray-800/80">
      <div class="flex items-center gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center p-2">
          <img src="/quatra-symbol-white.png" alt="Quatra" class="w-full h-full object-contain" />
        </div>
        <div>
          <span class="text-lg font-bold tracking-tight text-white">{siteConfig.brandName}</span>
          <p class="text-xs text-gray-500 font-medium">{siteConfig.tagline}</p>
        </div>
      </div>

      <div class="flex flex-wrap justify-center gap-6 text-xs sm:text-sm">
        {siteConfig.navLinks.map((link) => (
          <a href={link.href} class="hover:text-white transition-colors duration-200">
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500 font-mono">
      <p>© {new Date().getFullYear()} {siteConfig.brandName}. Software y Herramientas a Medida para Logística.</p>
      <p class="flex items-center gap-2">
        <span>📍 {siteConfig.location}</span>
      </p>
    </div>
  </div>
</footer>
