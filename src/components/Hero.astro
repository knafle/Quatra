---
import { siteConfig } from '../data/siteConfig';
---

<section class="relative pt-12 pb-20 md:pt-24 md:pb-32 overflow-hidden bg-[#08090D]">
  <!-- Background Grid & Glowing Quatra Motif -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

  <!-- Giant faint Quatra knot watermark in background center -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[520px] h-[520px] opacity-[0.04] pointer-events-none filter invert">
    <img src="/quatra-symbol-white.png" alt="" class="w-full h-full object-contain animate-spin" style="animation-duration: 180s;" />
  </div>

  <!-- Radial gradient glow -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-36 right-1/4 w-[350px] h-[250px] bg-amber-500/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <!-- Brand / Tech Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-white/10 bg-white/5 text-gray-300 text-xs font-mono tracking-wider uppercase mb-8 backdrop-blur-md shadow-inner">
      <img src="/quatra-symbol-white.png" alt="Quatra" class="w-4 h-4 object-contain opacity-80" />
      <span>QUATRA // Consultoría Operativa & Software a Medida</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] max-w-5xl mx-auto">
      Tu operación no debe adaptarse al software. <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-gray-100 via-gray-300 to-gray-400 bg-clip-text text-transparent">
        El software debe adaptarse a tu operación.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 sm:mt-8 text-lg sm:text-xl text-gray-400 max-w-3xl mx-auto leading-relaxed font-normal">
      Vamos a tu depósito o base de transporte, analizamos en el lugar dónde se traban tus procesos y desarrollamos <strong class="text-white font-medium">herramientas satélite a medida</strong> para recuperar cientos de horas-hombre al mes.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto sm:max-w-none">
      <a
        href={`https://wa.me/${siteConfig.contactWhatsApp}?text=Hola!%20Me%20gustar%C3%ADa%20coordinar%20una%20visita%20de%20diagn%C3%B3stico%20gratuita%20con%20el%20equipo%20de%20Quatra.`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-sm font-bold uppercase tracking-wider rounded-xl bg-white text-gray-950 hover:bg-gray-100 shadow-xl shadow-white/10 transition-all duration-300 hover:scale-[1.02] hover:-translate-y-0.5"
      >
        <span>Agendar Diagnóstico In-Situ (Sin Costo)</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href="#calculadora"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-sm font-semibold rounded-xl bg-gray-900/90 hover:bg-gray-800 text-gray-200 border border-gray-800 hover:border-gray-700 transition-all duration-200"
      >
        <span>Calcular Horas Ahorrables</span>
        <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
      </a>
    </div>

    <!-- Proof Points Grid -->
    <div class="mt-16 sm:mt-24 grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
      <div class="p-5 rounded-2xl bg-[#0E121B]/80 border border-white/5 backdrop-blur-sm text-left hover:border-white/10 transition-colors">
        <div class="text-2xl sm:text-3xl font-mono font-bold text-white">7 a 14 d.</div>
        <div class="text-xs text-gray-400 mt-1">Primera herramienta lista y en producción</div>
      </div>

      <div class="p-5 rounded-2xl bg-[#0E121B]/80 border border-white/5 backdrop-blur-sm text-left hover:border-white/10 transition-colors">
        <div class="text-2xl sm:text-3xl font-mono font-bold text-amber-400">+120 hs</div>
        <div class="text-xs text-gray-400 mt-1">Horas-hombre recuperadas promedio por mes</div>
      </div>

      <div class="p-5 rounded-2xl bg-[#0E121B]/80 border border-white/5 backdrop-blur-sm text-left hover:border-white/10 transition-colors">
        <div class="text-2xl sm:text-3xl font-mono font-bold text-emerald-400">0 Fricción</div>
        <div class="text-xs text-gray-400 mt-1">Se conecta a tus Excels y sistemas sin migraciones</div>
      </div>

      <div class="p-5 rounded-2xl bg-[#0E121B]/80 border border-white/5 backdrop-blur-sm text-left hover:border-white/10 transition-colors">
        <div class="text-2xl sm:text-3xl font-mono font-bold text-blue-400">4 Pilares</div>
        <div class="text-xs text-gray-400 mt-1">Metodología de campo probada en logística</div>
      </div>
    </div>
  </div>
</section>
