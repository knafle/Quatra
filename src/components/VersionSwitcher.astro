---
import { url } from '../data/siteConfig';

interface Props {
  currentVersion: string;
}

const { currentVersion } = Astro.props;

const versions = [
  { id: "1", path: url('1'), name: "v1: Minimal Noir", badge: "Screenshot Style", desc: "Monocromo puro, alta gama, estilo Linear/Apple" },
  { id: "2", path: url('2'), name: "v2: Industrial Tech", badge: "Operaciones", desc: "Detalles ámbar de seguridad, cuadrícula de muelle" },
  { id: "3", path: url('3'), name: "v3: Boutique Studio", badge: "Los Hermanos", desc: "Editorial, cercanía humana y acentos esmeralda" }
];
---

<div class="fixed top-4 left-1/2 -translate-x-1/2 z-50">
  <div class="flex items-center gap-1.5 p-1.5 rounded-full bg-neutral-900/90 border border-neutral-700/80 shadow-2xl backdrop-blur-xl">
    <div class="flex items-center gap-2 pl-3 pr-2 py-1 text-[11px] font-mono uppercase tracking-wider text-neutral-400 border-r border-neutral-700/60 hidden sm:flex">
      <img src={url('quatra-badge-hd.png')} alt="" class="w-4 h-4 rounded-sm" />
      <span>Probar Versión:</span>
    </div>

    <div class="flex items-center gap-1">
      {versions.map((v) => {
        const isActive = currentVersion === v.id;
        return (
          <a
            href={v.path}
            class={`px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-200 flex items-center gap-1.5 ${
              isActive
                ? "bg-white text-black font-bold shadow-md shadow-white/10 scale-105"
                : "text-neutral-400 hover:text-white hover:bg-neutral-800"
            }`}
            title={v.desc}
          >
            <span>{v.name}</span>
            {isActive && (
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            )}
          </a>
        );
      })}
    </div>
  </div>
</div>
