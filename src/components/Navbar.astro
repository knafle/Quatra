---
import { siteConfig } from '../data/siteConfig';
---

<header class="sticky top-0 z-40 w-full border-b border-gray-800/80 bg-[#08090D]/85 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-3.5 group">
      <div class="w-11 h-11 rounded-xl bg-white/5 border border-white/15 flex items-center justify-center p-2 shadow-lg shadow-black/40 group-hover:border-blue-400/50 group-hover:bg-white/10 transition-all duration-300">
        <img 
          src="/quatra-symbol-white.png" 
          alt="Quatra Logo" 
          class="w-full h-full object-contain filter group-hover:scale-105 transition-transform duration-300" 
        />
      </div>
      <div>
        <span class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-2">
          {siteConfig.brandName}
          <span class="inline-block w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
        </span>
        <span class="text-[11px] text-gray-400 block -mt-1 font-medium tracking-wider uppercase">Operaciones & Software</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-300">
      {siteConfig.navLinks.map((link) => (
        <a 
          href={link.href} 
          class="hover:text-white transition-colors duration-200 hover:translate-y-[-1px]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4">
      <a
        href={`https://wa.me/${siteConfig.contactWhatsApp}?text=Hola!%20Me%20gustar%C3%ADa%20agendar%20un%20diagn%C3%B3stico%20operativo%20gratuito%20con%20el%20equipo%20de%20Quatra.`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center px-4 py-2.5 text-xs uppercase tracking-wider font-bold rounded-lg bg-white text-gray-950 hover:bg-gray-100 shadow-md shadow-white/10 transition-all duration-200 hover:-translate-y-0.5"
      >
        Diagnóstico In-Situ
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-gray-400 hover:text-white hover:bg-gray-800 focus:outline-none"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-gray-800 bg-[#0E121B] px-4 pt-2 pb-6 space-y-3">
    {siteConfig.navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:text-white hover:bg-gray-800/60"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-2">
      <a
        href={`https://wa.me/${siteConfig.contactWhatsApp}?text=Hola!%20Me%20gustar%C3%ADa%20agendar%20un%20diagn%C3%B3stico%20operativo%20gratuito%20con%20el%20equipo%20de%20Quatra.`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center px-4 py-2.5 text-sm font-bold rounded-lg bg-white text-gray-950 shadow-md"
      >
        Diagnóstico In-Situ Sin Cargo
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }
</script>
