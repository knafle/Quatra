---
import Layout from '../layouts/Layout.astro';
import VersionSwitcher from '../components/VersionSwitcher.astro';
import { url } from '../data/siteConfig';

const assets = [
  {
    name: "Quatra Knot — Vector SVG",
    desc: "Isotipo vectorial puro con trazos Bézier. Escala a cualquier tamaño (4K, cartelería, camiones, web) sin perder nitidez.",
    format: "SVG Vector",
    previewType: "svg-white",
    downloadUrl: url("quatra-knot-white.svg"),
    altDownload: url("quatra-knot-black.svg"),
    altLabel: "Descargar en Negro"
  },
  {
    name: "Quatra App Icon Badge — Vector SVG",
    desc: "Insignia squircle blanca con el nudo negro en formato vectorial escalable. Ideal para apps móviles y favicons.",
    format: "SVG Vector",
    previewType: "badge-svg",
    downloadUrl: url("quatra-badge.svg"),
    altDownload: url("quatra-badge-dark.svg"),
    altLabel: "Descargar Dark Squircle"
  },
  {
    name: "Quatra Knot — PNG 2048x2048 px (Blanco)",
    desc: "Fondo transparente con trazos blancos en resolución Ultra-HD para fondos oscuros.",
    format: "PNG 2048px",
    previewType: "png-white",
    downloadUrl: url("quatra-knot-white-2048.png")
  },
  {
    name: "Quatra Knot — PNG 2048x2048 px (Negro)",
    desc: "Fondo transparente con trazos negros en resolución Ultra-HD para fondos claros o membretes.",
    format: "PNG 2048px",
    previewType: "png-black",
    downloadUrl: url("quatra-knot-black-2048.png")
  },
  {
    name: "Quatra Squircle Badge — PNG 2048x2048 px",
    desc: "Insignia redondeada ultra nítida con esquinas transparentes lista para perfiles sociales y WhatsApp Business.",
    format: "PNG 2048px",
    previewType: "png-badge",
    downloadUrl: url("quatra-badge-2048.png")
  }
];
---

<Layout title="Quatra — Brand Kit & Logo Assets (Vector SVG & 2048px)">
  <VersionSwitcher currentVersion="logo" />

  <div class="bg-black text-white min-h-screen selection:bg-white selection:text-black">
    <header class="border-b border-neutral-800 bg-black/90 backdrop-blur-md sticky top-0 z-40 pt-10 sm:pt-14 pb-4">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between">
        <a href={url("1")} class="flex items-center gap-3">
          <img src={url("quatra-badge-hd.png")} alt="Quatra Logo" class="w-9 h-9 rounded-xl" />
          <span class="text-xl font-bold tracking-tight text-white">Quatra</span>
          <span class="text-xs font-mono text-neutral-500 uppercase">// Brand Kit</span>
        </a>

        <div class="flex items-center gap-4">
          <a href={url("1")} class="text-xs font-mono text-neutral-400 hover:text-white transition-colors">
            ← Volver al Sitio
          </a>
          <a
            href={url("quatra-knot-white.svg")}
            download="quatra-knot-white.svg"
            class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg bg-white text-black hover:bg-neutral-200 transition-colors"
          >
            Descargar SVG
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <!-- Title -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-mono uppercase tracking-wider text-neutral-500">Recursos de Marca Oficiales</span>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mt-2">
          Quatra Brand Assets
        </h1>
        <p class="mt-4 text-neutral-400 text-sm sm:text-base leading-relaxed">
          Vectorizados con precisión matemática y curvas Bézier suaves a partir del isotipo original. Disponibles en SVG vectorial infinito y PNG Ultra-HD 2048x2048 px.
        </p>
      </div>

      <!-- Hero Preview of the Knot -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <!-- Dark Preview -->
        <div class="p-10 rounded-3xl bg-neutral-950 border border-neutral-800 flex flex-col items-center justify-center text-center relative overflow-hidden group">
          <div class="w-48 h-48 sm:w-60 sm:h-60 mb-6 flex items-center justify-center">
            <img src={url("quatra-knot-white.svg")} alt="Quatra White Vector" class="w-full h-full object-contain filter group-hover:scale-105 transition-transform duration-300" />
          </div>
          <span class="text-xs font-mono uppercase text-neutral-400 font-bold mb-1">Versión Blanco Puro (Dark Mode)</span>
          <span class="text-[11px] text-neutral-500 font-mono mb-4">SVG Vector // Fondo transparente</span>
          <div class="flex gap-2">
            <a href={url("quatra-knot-white.svg")} download="quatra-knot-white.svg" class="px-4 py-2 text-xs font-mono font-bold uppercase rounded-lg bg-white text-black hover:bg-neutral-200 transition-colors">
              Descargar SVG
            </a>
            <a href={url("quatra-knot-white-2048.png")} download="quatra-knot-white-2048.png" class="px-4 py-2 text-xs font-mono font-bold uppercase rounded-lg bg-neutral-900 border border-neutral-700 text-white hover:bg-neutral-800 transition-colors">
              PNG 2048px
            </a>
          </div>
        </div>

        <!-- Light Preview -->
        <div class="p-10 rounded-3xl bg-white text-black border border-neutral-300 flex flex-col items-center justify-center text-center relative overflow-hidden group">
          <div class="w-48 h-48 sm:w-60 sm:h-60 mb-6 flex items-center justify-center">
            <img src={url("quatra-knot-black.svg")} alt="Quatra Black Vector" class="w-full h-full object-contain filter group-hover:scale-105 transition-transform duration-300" />
          </div>
          <span class="text-xs font-mono uppercase text-neutral-800 font-bold mb-1">Versión Negro Puro (Light Mode)</span>
          <span class="text-[11px] text-neutral-500 font-mono mb-4">SVG Vector // Fondo transparente</span>
          <div class="flex gap-2">
            <a href={url("quatra-knot-black.svg")} download="quatra-knot-black.svg" class="px-4 py-2 text-xs font-mono font-bold uppercase rounded-lg bg-black text-white hover:bg-neutral-800 transition-colors">
              Descargar SVG
            </a>
            <a href={url("quatra-knot-black-2048.png")} download="quatra-knot-black-2048.png" class="px-4 py-2 text-xs font-mono font-bold uppercase rounded-lg bg-neutral-100 border border-neutral-300 text-black hover:bg-neutral-200 transition-colors">
              PNG 2048px
            </a>
          </div>
        </div>
      </div>

      <!-- Download Grid for All Assets -->
      <h2 class="text-xl font-bold text-white mb-6">Todos los Archivos Descargables</h2>
      <div class="space-y-4">
        {assets.map((item) => (
          <div class="p-6 rounded-2xl bg-neutral-950 border border-neutral-800 hover:border-neutral-700 transition-colors flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-neutral-900 border border-neutral-800 flex items-center justify-center p-3 shrink-0">
                <img src={item.downloadUrl} alt="" class="w-full h-full object-contain" />
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-base font-bold text-white">{item.name}</h3>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800 text-neutral-400 font-semibold uppercase">{item.format}</span>
                </div>
                <p class="text-xs text-neutral-400 mt-1 leading-relaxed max-w-xl">{item.desc}</p>
              </div>
            </div>

            <div class="flex items-center gap-3 shrink-0 w-full sm:w-auto">
              {item.altDownload && (
                <a
                  href={item.altDownload}
                  download
                  class="px-3.5 py-2 text-xs font-mono rounded-lg bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-700 transition-colors"
                >
                  {item.altLabel}
                </a>
              )}
              <a
                href={item.downloadUrl}
                download
                class="px-4 py-2 text-xs font-mono font-bold uppercase tracking-wider rounded-lg bg-white text-black hover:bg-neutral-200 transition-colors shadow-sm"
              >
                Descargar
              </a>
            </div>
          </div>
        ))}
      </div>
    </main>

    <footer class="py-12 border-t border-neutral-900 text-xs text-neutral-500 font-mono text-center">
      © {new Date().getFullYear()} Quatra. Isotipo y Recursos de Marca Registrados.
    </footer>
  </div>
</Layout>
