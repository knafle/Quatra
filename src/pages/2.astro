---
const b = import.meta.env.BASE_URL;
import Layout from '../layouts/Layout.astro';
import VersionSwitcher from '../components/VersionSwitcher.astro';
import { siteConfig } from '../data/siteConfig';

const pillars = [
  { code: "MOD-01", title: "Auditoría en Muelle", desc: "Relevamos in-situ cómo se mueven los bultos, remitos y choferes para cazar los cuellos de botella invisibles." },
  { code: "MOD-02", title: "Herramientas Satélite", desc: "Desarrollo rápido de aplicaciones web y de celular con interfaces de alto contraste y botones táctiles grandes." },
  { code: "MOD-03", title: "Conectores sin Fricción", desc: "Enlace directo con tus planillas de Excel, lectores de código de barras y sistema contable existente." },
  { code: "MOD-04", title: "Monitoreo de Horas-Hombre", desc: "Acompañamiento en planta y telemetría de tiempos para validar el ahorro de horas operativas." }
];
---

<Layout title="Quatra — Industrial Tech | Optimización Operativa para PyMEs">
  <VersionSwitcher currentVersion="2" />

  <div class="bg-[#0B0F19] text-gray-100 min-h-screen selection:bg-amber-500 selection:text-black font-sans">
    <!-- Header Industrial -->
    <header class="border-b border-gray-800 bg-[#0B0F19]/90 backdrop-blur-md sticky top-0 z-40 pt-10 sm:pt-14 pb-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between">
        <a href={`${b}2`} class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center p-2 group-hover:border-amber-400 transition-colors">
            <img src={`${b}quatra-knot-white.png`} alt="Quatra Logo" class="w-full h-full object-contain filter group-hover:rotate-45 transition-transform duration-500" />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xl font-black tracking-wider text-white uppercase">Quatra</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/30 text-amber-400 font-bold">OPS // TECH</span>
            </div>
            <span class="text-[10px] text-gray-500 block font-mono">INGENIERÍA LOGÍSTICA & SOFTWARE</span>
          </div>
        </a>

        <div class="hidden md:flex items-center gap-6 text-xs font-mono text-gray-400 uppercase">
          <a href="#pilares" class="hover:text-amber-400 transition-colors">01. Pilares</a>
          <a href="#calculadora" class="hover:text-amber-400 transition-colors">02. Simulador ROI</a>
          <a href="#soluciones" class="hover:text-amber-400 transition-colors">03. Herramientas</a>
        </div>

        <a
          href={`https://wa.me/${siteConfig.contactWhatsApp}?text=Hola!%20Quiero%20solicitar%20una%20auditor%C3%ADa%20operativa%20in-situ%20para%20nuestro%20dep%C3%B3sito.`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 text-xs font-mono font-bold uppercase rounded-lg bg-amber-500 hover:bg-amber-400 text-black shadow-lg shadow-amber-500/20 transition-all hover:scale-105"
        >
          [ Solicitar Auditoría ]
        </a>
      </div>
    </header>

    <main>
      <!-- Hero Industrial Tech -->
      <section class="pt-16 pb-24 md:pt-28 md:pb-36 relative overflow-hidden border-b border-gray-800">
        <!-- Blueprint Grid Pattern -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#3b82f610_1px,transparent_1px),linear-gradient(to_bottom,#3b82f610_1px,transparent_1px)] bg-[size:3rem_3rem] pointer-events-none"></div>
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-amber-500/10 rounded-full blur-[140px] pointer-events-none"></div>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 text-center">
          <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-md bg-gray-900 border border-gray-700 text-amber-400 text-xs font-mono uppercase mb-8 shadow-inner">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            <span>Muelle & Transporte // Software Satélite de Alta Productividad</span>
          </div>

          <h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight uppercase leading-[1.05]">
            Optimización y software <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">
              a la medida de tu muelle de carga
            </span>
          </h1>

          <p class="mt-8 text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
            Eliminamos el re-tipeo manual, el papel en el depósito y las planillas colgadas. Auditamos in-situ tu operación y desarrollamos programas a medida que calzan exactamente con cómo trabaja tu equipo.
          </p>

          <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={`https://wa.me/${siteConfig.contactWhatsApp}?text=Hola!%20Queremos%20coordinar%20una%20auditor%C3%ADa%20operativa%20in-situ%20con%20Quatra.`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-8 py-4 text-xs font-mono font-bold uppercase rounded-xl bg-amber-500 hover:bg-amber-400 text-black shadow-xl shadow-amber-500/20 transition-all hover:scale-105"
            >
              Auditoría en Depósito (2 Hs Sin Cargo)
            </a>

            <a
              href="#calculadora"
              class="w-full sm:w-auto px-8 py-4 text-xs font-mono font-bold uppercase rounded-xl bg-gray-900 hover:bg-gray-800 text-gray-300 border border-gray-700 transition-colors"
            >
              Simular Ahorro de Horas-Hombre
            </a>
          </div>

          <!-- Industrial Status Badges -->
          <div class="mt-20 grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
            <div class="p-4 rounded-xl bg-gray-900/80 border border-gray-800 text-left">
              <span class="text-[10px] font-mono text-gray-500 uppercase block">Sprint Operativo</span>
              <span class="text-2xl font-bold font-mono text-amber-400">10 Días</span>
              <p class="text-xs text-gray-400 mt-0.5">Puesta en marcha garantizada</p>
            </div>

            <div class="p-4 rounded-xl bg-gray-900/80 border border-gray-800 text-left">
              <span class="text-[10px] font-mono text-gray-500 uppercase block">Horas Recuperables</span>
              <span class="text-2xl font-bold font-mono text-amber-400">+120 hs/mes</span>
              <p class="text-xs text-gray-400 mt-0.5">Por equipo operativo</p>
            </div>

            <div class="p-4 rounded-xl bg-gray-900/80 border border-gray-800 text-left">
              <span class="text-[10px] font-mono text-gray-500 uppercase block">Integración</span>
              <span class="text-2xl font-bold font-mono text-emerald-400">0 Migración</span>
              <p class="text-xs text-gray-400 mt-0.5">Se acopla a tu sistema</p>
            </div>

            <div class="p-4 rounded-xl bg-gray-900/80 border border-gray-800 text-left">
              <span class="text-[10px] font-mono text-gray-500 uppercase block">Modalidad</span>
              <span class="text-2xl font-bold font-mono text-cyan-400">100% In-Situ</span>
              <p class="text-xs text-gray-400 mt-0.5">Relevamiento presencial</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Los 4 Pilares Industriales -->
      <section id="pilares" class="py-24 border-b border-gray-800 bg-[#0E1322]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
            <div>
              <span class="text-xs font-mono uppercase text-amber-400 font-bold tracking-wider">// METODOLOGÍA INDUSTRIAL</span>
              <h2 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight mt-1">
                Los 4 Módulos de Ejecución Quatra
              </h2>
            </div>
            <p class="text-sm text-gray-400 max-w-md font-mono">
              Un ciclo de optimización continuo que no frena los despachos diarios.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {pillars.map((p) => (
              <div class="p-6 rounded-2xl bg-[#090C14] border border-gray-800 hover:border-amber-500/50 transition-colors flex flex-col justify-between group">
                <div>
                  <div class="flex justify-between items-center mb-6">
                    <span class="text-xs font-mono font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">{p.code}</span>
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  </div>
                  <h3 class="text-lg font-bold text-white mb-2">{p.title}</h3>
                  <p class="text-xs text-gray-400 leading-relaxed">{p.desc}</p>
                </div>
                <div class="mt-6 pt-4 border-t border-gray-800/80 text-[10px] font-mono text-gray-500">
                  STATUS: LISTO PARA EJECUTAR
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Calculadora Industrial -->
      <section id="calculadora" class="py-24 border-b border-gray-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
          <div class="text-center mb-12">
            <span class="text-xs font-mono text-amber-400 uppercase font-bold tracking-wider">// SIMULADOR DE COSTO Y FUGAS</span>
            <h2 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight mt-1">
              Telemetría de Horas-Hombre en tu Empresa
            </h2>
          </div>

          <div class="p-8 sm:p-10 rounded-3xl bg-[#0E1322] border-2 border-gray-800 shadow-2xl">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              <div class="lg:col-span-7 space-y-6">
                <div>
                  <div class="flex justify-between text-xs font-mono mb-2">
                    <span class="text-gray-300">DOTACIÓN EN ADMINISTRACIÓN / DEPÓSITO:</span>
                    <span id="v2-emp-val" class="text-amber-400 font-bold">5 OPERARIOS</span>
                  </div>
                  <input id="v2-emp-range" type="range" min="1" max="40" value="5" class="w-full h-2 bg-gray-800 rounded appearance-none cursor-pointer accent-amber-500" />
                </div>

                <div>
                  <div class="flex justify-between text-xs font-mono mb-2">
                    <span class="text-gray-300">HORAS DIARIAS POR OPERARIO EN PLANILLAS:</span>
                    <span id="v2-hours-val" class="text-amber-400 font-bold">2.5 HORAS / DÍA</span>
                  </div>
                  <input id="v2-hours-range" type="range" min="0.5" max="5" value="2.5" step="0.5" class="w-full h-2 bg-gray-800 rounded appearance-none cursor-pointer accent-amber-500" />
                </div>

                <div>
                  <div class="flex justify-between text-xs font-mono mb-2">
                    <span class="text-gray-300">COSTO HORA HOMBRE ESTIMADO:</span>
                    <span id="v2-cost-val" class="text-amber-400 font-bold">$10 USD / HR</span>
                  </div>
                  <input id="v2-cost-range" type="range" min="5" max="40" value="10" step="1" class="w-full h-2 bg-gray-800 rounded appearance-none cursor-pointer accent-amber-500" />
                </div>
              </div>

              <div class="lg:col-span-5 p-6 rounded-2xl bg-[#090C14] border border-amber-500/30 flex flex-col justify-between">
                <div>
                  <span class="text-[10px] font-mono text-gray-500 uppercase block mb-3">// CÁLCULO DE RECUPERO</span>
                  
                  <div class="mb-4 pb-4 border-b border-gray-800">
                    <span class="text-xs text-gray-400 block font-mono">Horas quemadas por mes:</span>
                    <span class="text-3xl font-mono font-black text-white"><span id="v2-lost">250</span> HS</span>
                  </div>

                  <div class="mb-6">
                    <span class="text-xs text-amber-400 block font-mono font-bold">HORAS RECUPERABLES (ESTIMADO):</span>
                    <span class="text-4xl font-mono font-black text-amber-400"><span id="v2-rec">175</span> HS / MES</span>
                    <div class="text-xs font-mono text-gray-400 mt-2">Ahorro anual: <strong id="v2-ann" class="text-white">$21.000 USD</strong></div>
                  </div>
                </div>

                <a
                  id="v2-wa"
                  href={`https://wa.me/${siteConfig.contactWhatsApp}?text=Hola!%20Hice%20el%20c%C3%A1lculo%20en%20Quatra%20Ops%20para%20un%20equipo%20de%205%20operarios%20y%20nos%20da%20175%20hs%20recuperables.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-3.5 text-center text-xs font-mono font-bold uppercase rounded-xl bg-amber-500 hover:bg-amber-400 text-black shadow-lg shadow-amber-500/20 transition-all hover:scale-105"
                >
                  [ Recuperar estas horas ]
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Final Industrial -->
      <section class="py-24 bg-[#090C14] text-center">
        <div class="max-w-4xl mx-auto px-4">
          <span class="text-xs font-mono uppercase text-amber-400 font-bold">[ FASE 1: VISITA EN PLANTA ]</span>
          <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight mt-2">
            Dejá de operar a ciegas con planillas rotas
          </h2>
          <p class="mt-4 text-gray-400 text-base max-w-xl mx-auto">
            Vamos a tu depósito 2 horas, vemos el flujo real con tus despachantes y te mostramos cómo solucionarlo.
          </p>
          <div class="mt-8 flex justify-center">
            <a
              href={`https://wa.me/${siteConfig.contactWhatsApp}?text=Hola!%20Queremos%20coordinar%20la%20auditor%C3%ADa%20operativa%20in-situ.`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-4 text-xs font-mono font-bold uppercase rounded-xl bg-amber-500 hover:bg-amber-400 text-black shadow-xl shadow-amber-500/30 transition-all"
            >
              Contactar por WhatsApp
            </a>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>

<script>
  import { siteConfig } from '../data/siteConfig';

  function initV2() {
    const emp = document.getElementById('v2-emp-range') as HTMLInputElement | null;
    const hours = document.getElementById('v2-hours-range') as HTMLInputElement | null;
    const cost = document.getElementById('v2-cost-range') as HTMLInputElement | null;

    const empVal = document.getElementById('v2-emp-val');
    const hoursVal = document.getElementById('v2-hours-val');
    const costVal = document.getElementById('v2-cost-val');

    const lostEl = document.getElementById('v2-lost');
    const recEl = document.getElementById('v2-rec');
    const annEl = document.getElementById('v2-ann');
    const wa = document.getElementById('v2-wa') as HTMLAnchorElement | null;

    if (!emp || !hours || !cost) return;

    function calc() {
      const e = parseInt(emp.value, 10);
      const h = parseFloat(hours.value);
      const c = parseFloat(cost.value);

      const lost = Math.round(e * h * 20);
      const rec = Math.round(lost * 0.70);
      const ann = Math.round(rec * c * 12);

      if (empVal) empVal.textContent = `${e} OPERARIOS`;
      if (hoursVal) hoursVal.textContent = `${h} HORAS / DÍA`;
      if (costVal) costVal.textContent = `$${c} USD / HR`;

      if (lostEl) lostEl.textContent = lost.toString();
      if (recEl) recEl.textContent = rec.toString();
      if (annEl) annEl.textContent = `$${ann.toLocaleString('es-AR')} USD`;

      if (wa) {
        const msg = encodeURIComponent(`Hola! Usamos el simulador de Quatra Ops para ${e} operarios y queremos auditar las ${rec} hs recuperables.`);
        wa.href = `https://wa.me/${siteConfig.contactWhatsApp}?text=${msg}`;
      }
    }

    emp.addEventListener('input', calc);
    hours.addEventListener('input', calc);
    cost.addEventListener('input', calc);
    calc();
  }

  document.addEventListener('DOMContentLoaded', initV2);
  initV2();
</script>
