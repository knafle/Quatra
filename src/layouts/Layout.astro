---
import '../styles/global.css';
import { siteConfig, url } from '../data/siteConfig';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.brandName} | Consultoría de Rendimiento Operativo para Logística PyME`,
  description = "Consultoría de rendimiento y optimización de procesos en depósito y muelle. Vamos a tu planta, auditamos tus procesos in-situ y construimos herramientas a medida para recuperar horas-hombre."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / WhatsApp Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.brandName} />
    <meta property="og:image" content={url('quatra-badge-hd.png')} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#0B0F19] text-gray-100 font-['Plus_Jakarta_Sans',sans-serif] min-h-screen selection:bg-blue-600 selection:text-white">
    <slot />

    <!-- WhatsApp Floating Quick Button -->
    <a
      href={`https://wa.me/${siteConfig.contactWhatsApp}?text=Hola!%20Vi%20su%20web%20y%20me%20gustar%C3%ADa%20coordinar%20un%20diagn%C3%B3stico%20operativo%20gratuito.`}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 flex items-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-3 rounded-full shadow-2xl transition-all duration-300 hover:scale-105 group border border-emerald-400/30"
      aria-label="Hablar por WhatsApp"
    >
      <div class="relative flex items-center justify-center">
        <span class="absolute -top-1 -right-1 flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
        </span>
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.392-12.416c-6.627 0-12 5.373-12 12 0 2.123.553 4.116 1.518 5.852l-1.618 5.91 6.071-1.593c1.674.912 3.593 1.431 5.629 1.431 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
        </svg>
      </div>
      <span class="text-sm font-semibold hidden sm:inline-block">Escribinos por WhatsApp</span>
    </a>
  </body>
</html>
